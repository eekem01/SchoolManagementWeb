@model AssessmentSummaryViewModel
@{
    ViewData["Title"] = "Assessment Summary";
}

<div class="compact-page">
    <div class="page-header">
        <h2 class="page-title">
            <i class="bi bi-clipboard-data me-1"></i>Assessment Summary
            @if (Model.Examination != null)
            {
                <span class="exam-info">| @Model.Examination.Name (@Model.Examination.AcademicYear) | @Model.Examination.EndDate.ToString("MMM dd, yyyy")</span>
            }
        </h2>
    </div>

    @if (Model.Assessments != null && Model.Assessments.Any())
    {
        <div class="table-container">
            <table class="table table-sm table-striped table-bordered compact-table">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Student</th>
                        <th>Subject</th>
                        <th>Marks</th>
                        <th>%</th>
                        <th>Grade</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var assessment in Model.Assessments)
                    {
                        <tr>
                            <td class="fw-bold">@assessment.StudentId</td>
                            <td>@assessment.StudentName</td>
                            <td>@assessment.Subject</td>
                            <td>@assessment.ObtainedMarks/@assessment.TotalMarks</td>
                            <td>
                                <span class="badge badge-sm bg-@GetPercentageBadgeColor(assessment.Percentage)">
                                    @assessment.Percentage.ToString("F0")%
                                </span>
                            </td>
                            <td>
                                <span class="badge badge-sm bg-@GetGradeBadgeColor(assessment.Grade)">
                                    @assessment.Grade
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-secondary">
                    <tr>
                        <td colspan="6" class="text-center fw-bold small">Total: @Model.Assessments.Count Records</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info py-2" role="alert">
            <i class="bi bi-info-circle me-1"></i>No assessment data available.
        </div>
    }
</div>

@functions {
    private string GetPercentageBadgeColor(decimal percentage)
    {
        return percentage >= 90 ? "success" : percentage >= 80 ? "info" : percentage >= 70 ? "warning" : "danger";
    }

    private string GetGradeBadgeColor(string grade)
    {
        return grade switch
        {
            "A+" => "success",
            "A" => "success",
            "A-" => "info",
            "B+" => "info",
            "B" => "warning",
            "B-" => "warning",
            "C+" => "warning",
            "C" => "danger",
            _ => "secondary"
        };
    }
}

